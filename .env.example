# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Which vendor to use: openai | anthropic | google
SUPPORT_PROVIDER=openai

# API key for the selected provider (only one is needed)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional: override the default model for the provider
# SUPPORT_MODEL=gpt-4o-mini
# SUPPORT_EMBEDDING_MODEL=text-embedding-3-small

# Optional: OpenAI-compatible gateway / proxy instead of api.openai.com
# SUPPORT_BASE_URL=https://your-gateway.example.com/v1

# Optional tuning
# SUPPORT_TEMPERATURE=0
# SUPPORT_TOP_K=3
# SUPPORT_ENABLE_HITL=true
